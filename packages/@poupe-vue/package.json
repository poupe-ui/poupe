{
  "name": "@poupe/vue",
  "version": "0.6.4",
  "type": "module",
  "description": "Vue component library for Poupe UI framework with theme customization and accessibility support",
  "author": "Alejandro Mery <amery@apptly.co>",
  "license": "MIT",
  "homepage": "https://poupe.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poupe-ui/poupe.git",
    "directory": "packages/@poupe-vue"
  },
  "bugs": {
    "url": "https://github.com/poupe-ui/poupe/issues"
  },
  "keywords": [
    "components",
    "design-system",
    "material-design",
    "material-design-3",
    "poupe",
    "tailwindcss",
    "theming",
    "typescript",
    "ui-library",
    "vue",
    "vue3"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./*/index.css": "./dist/*/index.css",
    "./components": {
      "types": "./dist/components/index.d.mts",
      "default": "./dist/components/index.mjs"
    },
    "./composables": {
      "types": "./dist/composables/index.d.mts",
      "default": "./dist/composables/index.mjs"
    },
    "./composables/*": {
      "types": "./dist/composables/*.d.mts",
      "default": "./dist/composables/*.mjs"
    },
    "./config": {
      "types": "./dist/config/index.d.mts",
      "default": "./dist/config/index.mjs"
    },
    "./resolver": {
      "types": "./dist/resolver/index.d.mts",
      "default": "./dist/resolver/index.mjs"
    },
    "./story-viewer": {
      "types": "./dist/story-viewer/index.d.mts",
      "default": "./dist/story-viewer/index.mjs"
    },
    "./theme-scheme": {
      "types": "./dist/theme-scheme/index.d.mts",
      "default": "./dist/theme-scheme/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "obuild",
    "clean": "rimraf dist node_modules",
    "dev": "vite",
    "dev:prepare": "obuild --stub",
    "lint": "eslint --fix .",
    "lint:_pkg-pr-new": "eslint --fix package.json",
    "lint:check": "eslint .",
    "precommit": "run-s dev:prepare lint type-check build test",
    "prepack": "run-s lint:_pkg-pr-new lint:check type-check build test publint",
    "prepare": "cross-test -s dist/index.mjs || obuild --stub",
    "publint": "publint",
    "publish:maybe": "npm view ${npm_package_name}@${npm_package_version} version 2>/dev/null && echo \"${npm_package_name}@${npm_package_version} already published\" || pnpm publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc --build --force"
  },
  "dependencies": {
    "@iconify-json/material-symbols": "^1.2.71",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@iconify/vue": "^5.0.1",
    "@poupe/css": "workspace:^",
    "@poupe/tailwindcss": "workspace:^",
    "@poupe/theme-builder": "workspace:^",
    "@unhead/vue": "^2.1.15",
    "@vueuse/core": "^13.9.0",
    "defu": "^6.1.7",
    "reka-ui": "^2.3.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-scrollbar": "^4.0.2",
    "tailwind-variants": "^1.0.0",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@kagal/cross-test": "^0.1.3",
    "@poupe/eslint-config": "^0.9.1",
    "@poupe/rolldown-vue-css": "workspace:^",
    "@tailwindcss/vite": "^4.3.0",
    "@tsconfig/node20": "^20.1.9",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.19.43",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.4",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^8.0.4",
    "obuild": "^0.4.34",
    "publint": "^0.3.20",
    "typescript": "^6.0.3",
    "unplugin-vue": "^6.2.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.2.8"
  },
  "peerDependencies": {
    "unplugin-vue-components": "^28.0.0",
    "vue-router": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "unplugin-vue-components": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.20.2",
    "pnpm": ">=10.33.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@poupe/rolldown-vue-css",
  "version": "0.1.1",
  "type": "module",
  "description": "Rolldown plugin that emits Vue SFC <style> blocks as per-component CSS build assets, suitable for strict-CSP consumers",
  "author": "Alejandro Mery <amery@apptly.co>",
  "license": "MIT",
  "homepage": "https://github.com/poupe-ui/poupe/tree/main/packages/@poupe-rolldown-vue-css#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poupe-ui/poupe.git",
    "directory": "packages/@poupe-rolldown-vue-css"
  },
  "bugs": {
    "url": "https://github.com/poupe-ui/poupe/issues"
  },
  "keywords": [
    "asset",
    "build",
    "csp",
    "css",
    "plugin",
    "poupe",
    "rolldown",
    "sfc",
    "style",
    "vue"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "obuild",
    "clean": "rimraf dist node_modules",
    "dev": "vitest watch",
    "dev:prepare": "obuild --stub",
    "lint": "eslint --fix .",
    "lint:_pkg-pr-new": "eslint --fix package.json",
    "lint:check": "eslint .",
    "precommit": "run-s dev:prepare lint type-check build test",
    "prepack": "run-s lint:_pkg-pr-new lint:check type-check build test publint",
    "prepare": "cross-test -s dist/index.mjs || obuild --stub",
    "publint": "publint",
    "publish:maybe": "npm view ${npm_package_name}@${npm_package_version} version 2>/dev/null && echo \"${npm_package_name}@${npm_package_version} already published\" || pnpm publish",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "consola": "^3.4.2",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@kagal/cross-test": "^0.1.3",
    "@poupe/eslint-config": "^0.9.1",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.4",
    "npm-run-all2": "^8.0.4",
    "obuild": "^0.4.34",
    "publint": "^0.3.20",
    "rolldown": "^1.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "rolldown": "1.x || ^1.0.0-beta || ^1.0.0-rc"
  },
  "engines": {
    "node": ">=24.20.0",
    "pnpm": ">=10.33.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "publishConfig": {
    "access": "public"
  }
}

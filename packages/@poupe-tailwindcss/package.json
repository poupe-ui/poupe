{
  "name": "@poupe/tailwindcss",
  "version": "0.5.2",
  "type": "module",
  "description": "TailwindCSS v4 plugin for Poupe UI framework with theme customization support",
  "author": "Alejandro Mery <amery@apptly.co>",
  "license": "MIT",
  "homepage": "https://poupe.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poupe-ui/poupe.git",
    "directory": "packages/@poupe-tailwindcss"
  },
  "bugs": {
    "url": "https://github.com/poupe-ui/poupe/issues"
  },
  "keywords": [
    "css",
    "design-system",
    "design-tokens",
    "material-design",
    "material-design-3",
    "poupe",
    "tailwind",
    "tailwindcss",
    "theming",
    "typescript",
    "ui-framework"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "style": "./dist/style.css",
      "default": "./dist/index.mjs"
    },
    "./theme": {
      "types": "./dist/theme/index.d.mts",
      "default": "./dist/theme/index.mjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.mts",
      "default": "./dist/utils/index.mjs"
    }
  },
  "style": "./dist/style.css",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "obuild",
    "clean": "rimraf dist node_modules",
    "dev": "vitest watch",
    "dev:prepare": "obuild --stub",
    "lint": "eslint --fix .",
    "lint:_pkg-pr-new": "eslint --fix package.json",
    "lint:check": "eslint .",
    "precommit": "run-s dev:prepare lint type-check build test",
    "prepack": "run-s lint:_pkg-pr-new lint:check type-check build test publint",
    "prepare": "cross-test -s dist/index.mjs || obuild --stub",
    "publint": "publint",
    "publish:maybe": "npm view ${npm_package_name}@${npm_package_version} version 2>/dev/null && echo \"${npm_package_name}@${npm_package_version} already published\" || pnpm publish",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@poupe/css": "workspace:^",
    "@poupe/theme-builder": "workspace:^",
    "type-fest": "^4.41.0"
  },
  "devDependencies": {
    "@kagal/cross-test": "^0.1.3",
    "@poupe/eslint-config": "^0.9.1",
    "@tailwindcss/node": "^4.3.0",
    "@types/node": "^20.19.40",
    "consola": "^3.4.2",
    "eslint": "^9.39.4",
    "obuild": "^0.4.34",
    "pathe": "^2.0.3",
    "publint": "^0.3.20",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.2.8"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3.0"
  },
  "engines": {
    "node": ">=20.19.2",
    "pnpm": ">=10.33.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "publishConfig": {
    "access": "public"
  }
}
